<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/blue_mist">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="РЕГИСТРАЦИЯ УСТРОЙСТВА"
        android:textColor="@color/brand_blue_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Данные устройства"
        android:textColor="@color/graphite"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя устройства"
        android:textColor="@color/graphite_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/deviceName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/deviceName"
        android:textColorHint="@color/muted_light"
        android:textColor="@color/graphite"
        android:textSize="14sp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пароль устройства"
        android:textColor="@color/graphite_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/devicePassword"
        android:textColorHint="@color/muted_light"
        android:textColor="@color/graphite"
        android:textSize="14sp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"
        tools:ignore="LabelFor" />

    <Button
        android:id="@+id/registration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/Registration"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/button_background"/>

</LinearLayout>
