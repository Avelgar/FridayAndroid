<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ПОДКЛЮЧЕНИЕ"
        android:textColor="@color/brand_blue_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Подключение устройства"
        android:textColor="@color/graphite"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя устройства"
        android:textColor="@color/graphite_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/et_device_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Введите имя устройства"
        android:textColorHint="@color/muted_light"
        android:textColor="@color/graphite"
        android:textSize="14sp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Пароль устройства"
        android:textColor="@color/graphite_soft"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/et_device_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Введите пароль"
        android:textColorHint="@color/muted_light"
        android:textColor="@color/graphite"
        android:textSize="14sp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:inputType="textPassword"/>

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Подключить"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/button_background"
        android:layout_marginTop="20dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/brand_blue_dark"
        android:textSize="13sp"
        android:visibility="gone"/>
</LinearLayout>